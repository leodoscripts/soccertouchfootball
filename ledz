            buttons.MAG.BackgroundColor3  = cfg.magnet and ON or OFF
            buttons.SNAP.BackgroundColor3 = snapping and ON or OFF
            buttons.FARM.BackgroundColor3 = cfg.afkFarm and ON or OFF
            task.wait(0.2)
        end
    end)
end

task.spawn(function()
    while S.alive() and not Fluent.Unloaded do
        local ball = getBall()
        local line = ("mode %d | team %s (%s) | ball %s | %s"):format(
            C.mode or 0, myLetter(), myTeamName(), ball and "yes" or "no", stats.lastMsg)
        local farmLine = ("team %s  |  goals %d  |  tries %d  |  refused %d  |  rejoins %d  |  %s")
            :format(hasTeam() and myTeamName() or "NONE (spectator)",
                stats.goals, stats.attempts, stats.refused, stats.rejoins,
                cfg.afkFarm and "RUNNING" or "stopped")
        if not pcall(function() statusPara:SetDesc(line) end) then
            pcall(function() statusPara:SetTitle("Status - " .. stats.lastMsg) end)
        end
        if not pcall(function() farmPara:SetDesc(farmLine) end) then
            pcall(function() farmPara:SetTitle(farmLine) end)
        end
        task.wait(0.5)
    end
end)

S.connect(UserInputService.InputBegan, function(input, gpe)
    if gpe or UserInputService:GetFocusedTextBox() then return end
    local k = input.KeyCode
    if k == Enum.KeyCode.RightAlt then
        Options.AutoGoal:SetValue(not cfg.autoGoal)
    elseif k == Enum.KeyCode.RightShift then
        Options.Magnet:SetValue(not cfg.magnet)
    elseif k == Enum.KeyCode.V then
        snapGoal()
    elseif k == Enum.KeyCode.Insert then
        Options.AfkFarm:SetValue(not cfg.afkFarm)
    elseif k == Enum.KeyCode.Delete then
        if getgenv().LedZTF then getgenv().LedZTF.unload() end
    end
end)

task.spawn(function()
    while S.alive() do
        if cfg.afkFarm and not farmThread then
            stats.lastMsg = "farm: restarting worker"
            startFarm()
        end
        task.wait(2)
    end
end)

local function unload()
    cfg.autoGoal, cfg.magnet, cfg.afkFarm = false, false, false
    cfg.speedHack, cfg.sprint = false, false
    hideAll()
    for _, d in ipairs(drawings) do pcall(function() d:Remove() end) end
    pcall(function() Fluent:Destroy() end)
    pcall(function() barGui:Destroy() end)
    local c = LP.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    if h then pcall(function() h.WalkSpeed = 16 end) end
    getgenv().LedZTF = nil
end

getgenv().LedZTF = { cfg = cfg, stats = stats, Fluent = Fluent, Window = Window,
    Bar = barGui, C = C, unload = unload, snapGoal = snapGoal, startFarm = startFarm }
getgenv().JuniorOP = nil

S.onCleanup(unload)

Fluent:Notify({
    Title = "LedZ Touch Football",
    Content = "Loaded. Farm tab = AFK goal farm.",
    SubContent = "team " .. myLetter() .. " | mode " .. tostring(C.mode),
    Duration = 6,
})

end

local checking = false

local function verify()
    if checking then return end
    checking = true
    local entered = input.Text:gsub("%s+", "")
    continueBtn.Text = "Checking..."
    task.wait(0.4)

    if entered == KEY then
        continueBtn.Text = "Verified"
        status.Text = "Access granted"
        task.wait(0.35)
        closeKey()
        task.spawn(function()
            local ok, err = pcall(launch)
            if not ok then warn(err) end
        end)
    else
        continueBtn.Text = "Continue"
        status.Text = "Invalid key"
        boxStroke.Transparency = 0.2
        task.spawn(shake)
        task.delay(1.6, function()
            status.Text = ""
            boxStroke.Transparency = 0.7
        end)
        checking = false
    end
end

continueBtn.MouseButton1Click:Connect(verify)
input.FocusLost:Connect(function(enter)
    if enter then verify() end
end)
