local function refreshConstants()
    local ff = workspace:FindFirstChild("FootballField")
    local mode = 1
    if ff then
        local m = ff:FindFirstChild("SoccerGameMode")
        if m then mode = m.Value end
    end
    local u80, u81, u82, u78, u79 = 0, 0, 0.55, 5.473, 55
    if mode == 2 then
        u80, u81, u82 = 2.2, 2.2, 0.5
    elseif mode == 3 then
        u81, u82, u78, u79 = 6.4, 0.6, u78 + 0.5, 45
    elseif mode == 4 then
        u80, u81, u82 = 2.2, 2.2, 0.6
    end
    C.mode    = mode
    C.gravity = u79
    C.floor   = u78
    C.zMin    = u80 + 78.036
    C.zMax    = 107.715 - u80
    C.barY    = u81 + 18
    C.goalY   = u81 + 17
end
