local function predictLanding(pos, vel)
    local g = C.gravity
    local y0 = math.max(pos.Y - C.floor, 0)
    local disc = vel.Y * vel.Y + 2 * g * y0
    if disc < 0 then return nil end
    local t = (vel.Y + math.sqrt(disc)) / g
    if t <= 0.02 or t > 12 then return nil end
    return Vector3.new(pos.X + vel.X * t, C.floor, pos.Z + vel.Z * t)
end

local function drawESP()
    local cam = workspace.CurrentCamera
    if not cam then hideAll(); return end
    local vs = cam.ViewportSize

    local ball = getBall()
    if cfg.espBall and ball then
        local sp, on = cam:WorldToViewportPoint(ball.Position)
        if on then
            ballRing.Position = Vector2.new(sp.X, sp.Y)
            ballRing.Radius   = math.clamp(220 / math.max(sp.Z, 1), 5, 40)
            ballRing.Visible  = true
            ballText.Position = Vector2.new(sp.X, sp.Y + ballRing.Radius + 3)
            ballText.Text     = ("BALL  %dm  %d sps"):format(
                (ball.Position - cam.CFrame.Position).Magnitude, ball.Velocity.Magnitude)
            ballText.Visible  = true
            tracer.Visible = cfg.espTracer
            if cfg.espTracer then
                tracer.From = Vector2.new(vs.X * 0.5, vs.Y)
                tracer.To   = Vector2.new(sp.X, sp.Y)
            end
        else
            ballRing.Visible = false; ballText.Visible = false; tracer.Visible = false
        end

        if cfg.espPredict then
            local land = predictLanding(ball.Position, ball.Velocity)
            if land then
                local lp, lon = cam:WorldToViewportPoint(land)
                predRing.Visible = lon
                if lon then
                    predRing.Position = Vector2.new(lp.X, lp.Y)
                    predRing.Radius   = math.clamp(160 / math.max(lp.Z, 1), 4, 26)
                end
            else
                predRing.Visible = false
            end
        else
            predRing.Visible = false
        end
    else
        ballRing.Visible = false; ballText.Visible = false
        predRing.Visible = false; tracer.Visible = false
    end

    if not cfg.espPlayers then
        for _, e in ipairs(pool) do e.box.Visible = false; e.name.Visible = false end
        return
    end

    local mine = myTeamName()
    local i = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and i < #pool then
            local c = p.Character
            local hrp = c and c:FindFirstChild("HumanoidRootPart")
            if hrp then
                local head, hon = cam:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0))
                local feet      = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                if hon then
                    i += 1
                    local e = pool[i]
                    local h = math.abs(feet.Y - head.Y)
                    local w = h * 0.55
                    local tv = c:FindFirstChild("Team")
                    local col = (tv and tv.Value == mine)
                        and Color3.fromRGB(110, 230, 130) or Color3.fromRGB(255, 105, 105)
                    e.box.Position = Vector2.new(head.X - w * 0.5, head.Y)
                    e.box.Size     = Vector2.new(w, h)
                    e.box.Color    = col
                    e.box.Visible  = true
                    e.name.Position = Vector2.new(head.X, head.Y - 15)
                    e.name.Text     = p.Name
                    e.name.Color    = col
                    e.name.Visible  = true
                end
            end
        end
    end
    for j = i + 1, #pool do
        pool[j].box.Visible = false
        pool[j].name.Visible = false
    end
end

