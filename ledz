local function launchFor(P, aim, speed, g)
    local dx, dz = aim.X - P.X, aim.Z - P.Z
    local dh = math.sqrt(dx * dx + dz * dz)
    if dh < 0.001 then return nil end
    local t = dh / speed
    return Vector3.new(dx / t, (aim.Y - P.Y) / t + 0.5 * g * t, dz / t)
end

local function keeperZ(letter)
    local gx = targetPlaneX(letter)
    local mine = myTeamName()
    local bestZ, bestD = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local c = p.Character
            local hrp = c and c:FindFirstChild("HumanoidRootPart")
            local tv = c and c:FindFirstChild("Team")
            if hrp and (not tv or tv.Value ~= mine) then
                local d = math.abs(hrp.Position.X - gx)
                if d < bestD then bestD, bestZ = d, hrp.Position.Z end
            end
        end
    end
    if bestD > 45 then return nil end
    return bestZ
end

local function aimPoints(letter)
    local planeX = targetPlaneX(letter)
    local aimX = (letter == "A") and (planeX + 5) or (planeX - 5)
    local zLo, zHi = C.zMin + 4.5, C.zMax - 4.5
    local zc = (C.zMin + C.zMax) * 0.5

    local first, second = zLo, zHi
    local kz = keeperZ(letter)
    if kz and math.abs(kz - zHi) > math.abs(kz - zLo) then first, second = zHi, zLo end

    return {
        Vector3.new(aimX, C.floor + 1.5, first),
        Vector3.new(aimX, C.floor + 4.0, first),
        Vector3.new(aimX, C.floor + 1.5, second),
        Vector3.new(aimX, C.floor + 2.0, zc),
        Vector3.new(aimX, C.goalY - 4.0, zc),
    }
end

local function solveGoalKick(P, letter)
    local env = getEnv()
    if not env or type(env.recordBallAnimation) ~= "function" then return nil end

    local speeds
    if cfg.legitPower then
        speeds = { 85, 78, 68, 58, 48 }
    else
        local p = num(cfg.power, 380)
        speeds = { p, p * 0.75, p * 0.55, 160, 120, 95, 85, 70 }
    end

    local budget = 12
    for _, aim in ipairs(aimPoints(letter)) do
        for _, sp in ipairs(speeds) do
            if budget <= 0 then return nil end
            local vel = launchFor(P, aim, sp, C.gravity)
            if vel then
                local legal = true
                if cfg.legitPower then
                    legal = vel.Y <= 40 and Vector3.new(vel.X, 0, vel.Z).Magnitude <= 85
                end
                if legal then
                    budget -= 1
                    local ok, _, _, _, _, side = pcall(env.recordBallAnimation, P, vel, ZERO)
                    if ok and side == letter then return vel end
                end
            end
        end
    end
    return nil
end

local function amClosest(ballPos)
    local env = getEnv()
    if env and type(env.getClosestPlayerName) == "function" then
        local ok, n = pcall(env.getClosestPlayerName)
        if ok and type(n) == "string" then return n == LP.Name end
    end
    local best, bestD = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        local c = p.Character
        local hrp = c and c:FindFirstChild("HumanoidRootPart")
        if hrp then
            local d = (hrp.Position - ballPos).Magnitude
            if d < bestD then best, bestD = p.Name, d end
        end
    end
    return best == LP.Name
end

local lastKick = 0

local function magnetTo(ball)
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or not ball or not ball.Parent then return end
    local letter = myLetter()
    local zc = (C.zMin + C.zMax) * 0.5
    local toGoal = Vector3.new(targetPlaneX(letter) - ball.Position.X, 0, zc - ball.Position.Z)
    if toGoal.Magnitude < 0.01 then toGoal = Vector3.new(1, 0, 0) end
    toGoal = toGoal.Unit
    local standY = math.min(ball.Position.Y, C.floor) + 1.1
    local stand = ball.Position - toGoal * num(cfg.magnetDist, 2.4)
    stand = Vector3.new(stand.X, standY, stand.Z)
    hrp.CFrame = CFrame.lookAt(stand, Vector3.new(ball.Position.X, standY, ball.Position.Z))
end

local function ballGrounded(ball)
    return ball and ball.Parent and ball.Position.Y <= C.floor + 0.75
end

local function shoot(ball, env)
    local char = LP.Character
    local torso = char and (char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart"))
    if not torso or not ball or not ball.Parent then return false end

    if not hasTeam() then
        stats.lastMsg = "no team - goal would not count"
        return false
    end

    local P = ball.Position
    local letter = myLetter()
    local vel = solveGoalKick(P, letter)
    if not vel then
        stats.lastMsg = "no solution from here"
        return false
    end

    local dist = (P - torso.Position).Magnitude
    lastKick = tick()

    pcall(function()
        R.KickBall:FireServer(P, vel, ZERO, math.clamp(dist, 0.02, 4), PASS)
    end)
    pcall(env.startAnimation, P, vel, ZERO, ZERO, getPing())
    pcall(debug.setupvalue, env.touchDetect, 3, tick())

    stats.kicks += 1
    stats.lastMsg = ("shot -> goal %s @ %d sps"):format(letter, math.floor(vel.Magnitude))
    return true
end

local function acquire(timeout, stillWanted)
    local t0 = tick()
    while tick() - t0 < timeout and S.alive() do
        if stillWanted and not stillWanted() then return nil end
        local ball = getBall()
        if ball then
            magnetTo(ball)
            suppressVanillaKick()
            if amClosest(ball.Position) then return ball end
        end
        task.wait()
    end
    return nil
end

local function kickAccepted(kickTime, timeout)
    local t0 = tick()
    while tick() - t0 < (timeout or 0.8) do
        if lastAccept >= kickTime then return true end
        task.wait(0.05)
    end
    return false
end

local snapping = false
local function snapGoal()
    if snapping then return end
    snapping = true
    task.spawn(function()
        stats.attempts += 1
        local env = getEnv()
        local ball = env and acquire(3)
        local fired = false
        if ball and env then fired = shoot(ball, env) end
        if not fired then stats.lastMsg = "snap failed - never got possession" end
        snapping = false
    end)
end

local farmThread

local teamlessSince = 0

local function farmAttempt()
    local env = getEnv()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not env or not hrp then
        stats.lastMsg = "farm: waiting for character"
        task.wait(0.5)
        return
    end

    if not hasTeam() then
        if teamlessSince == 0 then teamlessSince = tick() end
        local waited = tick() - teamlessSince
        if cfg.autoRejoin and (not onPitch() or waited > 6) then
            stats.lastMsg = "farm: no team - walking back through JoinPortal"
            if rejoinPitch() then
                teamlessSince = 0
                stats.rejoins += 1
                stats.lastMsg = "farm: back on team " .. myTeamName()
            else
                stats.lastMsg = "farm: no team - match full, waiting for next one"
                task.wait(1.5)
            end
        else
            stats.lastMsg = ("farm: no team (%.0fs) - waiting"):format(waited)
            task.wait(0.5)
        end
        return
    end
    teamlessSince = 0

    if not getBall() then
        stats.lastMsg = "farm: waiting for ball"
        task.wait(0.25)
        return
    end

    local letter = myLetter()
    local before = scoreOf(letter)
    stats.attempts += 1

    local ball
    local t0 = tick()
    while tick() - t0 < 8 and cfg.afkFarm and S.alive() do
        ball = getBall()
        if ball then
            magnetTo(ball)
            suppressVanillaKick()
            if ballGrounded(ball) and amClosest(ball.Position) then break end
        end
        ball = nil
        task.wait()
    end
    if not ball then
        stats.lastMsg = "farm: ball never settled, retrying"
        return
    end

    task.wait(0.05)
    ball = getBall()
    if not ball or not ballGrounded(ball) or not amClosest(ball.Position) then
        stats.lastMsg = "farm: lost the ball, retrying"
        return
    end

    local kickAt = tick()
    if not shoot(ball, env) then
        task.wait(0.2)
        return
    end

    if not kickAccepted(kickAt, 0.9) then
        stats.refused += 1
        stats.lastMsg = "farm: server refused the kick, backing off"
        task.wait(0.35)
        return
    end

    local t0 = tick()
    while tick() - t0 < num(cfg.farmTimeout, 4) and cfg.afkFarm and S.alive() do
        local now = scoreOf(letter)
        if now > before then
            stats.goals += 1
            stats.lastMsg = ("farm: GOAL  (%d scored / %d tries)"):format(stats.goals, stats.attempts)
            local w = tick()
            while cfg.afkFarm and tick() - w < 10 and getBall() do task.wait(0.05) end
            w = tick()
            while cfg.afkFarm and tick() - w < 10 and not getBall() do task.wait(0.05) end
            if num(cfg.farmDelay, 0) > 0 then task.wait(num(cfg.farmDelay, 0)) end
            return
        elseif now < before then
            stats.lastMsg = "farm: match reset"
            return
        end
        if ballRespawned > kickAt then
            stats.lastMsg = "farm: ball reset without a goal, retrying"
            return
        end
        task.wait(0.1)
    end
    stats.lastMsg = "farm: shot did not land, retrying"
end

local function startFarm()
    if farmThread then return end
    farmThread = task.spawn(function()
        while cfg.afkFarm and S.alive() do
            local ok, err = pcall(farmAttempt)
            if not ok then
                stats.lastMsg = "farm error: " .. tostring(err)
                task.wait(0.5)
            end
            task.wait(0.05)
        end
        farmThread = nil
        if not cfg.afkFarm then stats.lastMsg = "farm stopped" end
    end)
end

